{
  "name": "plan-reply-joins",
  "about": "Plans, scenario 3 (docs/phases/07-planning.md): two replies arriving while the product turn runs join the next turn. The first turn ends with only its own message; the next turn is one turn carrying both replies, in order, and its brief is the next version.",
  "stages": ["plan"],
  "steps": [
    {"do": "plan", "plan": "p", "title": "Pantry list", "priority": "P2", "text": "a pantry list"},
    {"do": "script", "plan": "p", "for": "product", "play": "wait"},
    {"do": "runner", "claims": "p"},
    {"do": "agent_running", "plan": "p"},
    {"do": "plan_say", "plan": "p", "text": "only the kitchen"},
    {"do": "plan_say", "plan": "p", "text": "and the fridge"},
    {"do": "expect", "plans": {"p": {"turns": 2, "turn": "agent"}}},
    {"do": "script", "plan": "p", "for": "product", "play": "brief"},
    {"do": "release", "plan": "p"},
    {"do": "runner_idle"},
    {"do": "expect", "plans": {"p": {"turns": 2, "docs": {"brief": 1}}},
     "run_files": [{"plan": "p", "stage": "product", "run": 1, "file": "brief.md", "text": "> a pantry list\\n$", "no_text": "kitchen"}]},
    {"do": "runner", "claims": "p"},
    {"do": "runner_idle"},
    {"do": "runner", "claims": "none"}
  ],
  "expect": {
    "plans": {"p": {"stage": "brief", "turn": "you", "turns": 2, "last_turn": "done", "docs": {"brief": 2}}},
    "events": [{"plan": "p", "kind": "plan_turn_claimed", "actor": "runner", "count": 2}],
    "run_files": [{"plan": "p", "stage": "product", "run": 2, "file": "brief.md", "text": "^## This turn\\n[\\s\\S]*verbatim:\\n\\n> only the kitchen\\n\\n> and the fridge\\n$"}],
    "agent_runs": {"product": 2}
  }
}
