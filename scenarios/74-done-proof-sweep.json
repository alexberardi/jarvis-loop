{
  "name": "done-proof-sweep",
  "about": "Done proofs (docs/decisions/2026-10-18-done-proofs.md), the done sweep: a, b and c merge straight to done (no qa) without a proof, so each is done and unproven: done only meant merged and main green. At loopd's next tick one orchestrate turn gets a done_proof_needed trigger for each; the orchestrator writes a's proof (a command: proving), b's (a manual check: needs-you) and c's (a pi check: waiting), each thread saying so. The runner's next proof pass runs a's command and the loop marks a verified, quietly, still done. Every item stays done throughout. The next 09:00 standup in #loop-digest reports the done items: the counts per status and b on the user's short list with what to look at.",
  "stages": ["build", "review", "land", "orchestrate"],
  "steps": [
    {"do": "script", "for": "orchestrate", "play": "proofs"},
    {"do": "add", "item": "a", "title": "Round the kitchen timer"},
    {"do": "add", "item": "b", "title": "Board colours"},
    {"do": "add", "item": "c", "title": "Pi chime"},
    {"do": "script", "item": "a", "for": "proof", "proof": [{"kind": "command", "run": "git merge-base --is-ancestor \"$LOOP_MERGE_SHA\" HEAD"}]},
    {"do": "script", "item": "c", "for": "proof", "proof": [{"kind": "pi", "run": "aplay /usr/share/jarvis/chime.wav"}]},
    {"do": "ci", "main": {"ci": "pass"}},
    {"do": "triage", "item": "a"},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"},
    {"do": "ci", "item": "a", "checks": {"check": "pass"}},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"},
    {"do": "triage", "item": "b"},
    {"do": "runner", "claims": "b"},
    {"do": "runner_idle"},
    {"do": "ci", "item": "b", "checks": {"check": "pass"}},
    {"do": "runner", "claims": "b"},
    {"do": "runner_idle"},
    {"do": "runner", "claims": "b"},
    {"do": "runner_idle"},
    {"do": "triage", "item": "c"},
    {"do": "runner", "claims": "c"},
    {"do": "runner_idle"},
    {"do": "ci", "item": "c", "checks": {"check": "pass"}},
    {"do": "runner", "claims": "c"},
    {"do": "runner_idle"},
    {"do": "runner", "claims": "c"},
    {"do": "runner_idle"},
    {"do": "expect", "stage": {"a": "done", "b": "done", "c": "done"},
     "board": {"a": {"column": "Done", "card": "done · unproven"}},
     "no_events": [{"item": "a", "kind": "proof_set"}]},
    {"do": "clock", "advance": "1m"},
    {"do": "runner", "claims": "orchestrator"},
    {"do": "runner_idle"},
    {"do": "expect", "stage": {"a": "done", "b": "done", "c": "done"},
     "events": [{"kind": "orchestrate_claimed", "count": 1},
                {"item": "a", "kind": "proof_set", "actor": "orchestrator", "data": {"by": "^sweep$", "verify": "^proving$"}, "count": 1},
                {"item": "b", "kind": "proof_set", "actor": "orchestrator", "data": {"verify": "^needs-you$"}, "count": 1},
                {"item": "c", "kind": "proof_set", "actor": "orchestrator", "data": {"verify": "^waiting$"}, "count": 1}],
     "messages": [{"thread": "a", "from": "bot", "text": "^Orchestrator: wrote its proof \\(the done sweep\\): command: `git merge-base --is-ancestor \"\\$LOOP_MERGE_SHA\" HEAD` \\(pending\\) — from the item, its PR and evidence\\.$"},
                  {"thread": "b", "from": "bot", "text": "^Orchestrator: wrote its proof \\(the done sweep\\): look at the change in use \\(manual\\)"}],
     "board": {"a": {"column": "Done", "card": "done · proving"},
               "b": {"column": "Done", "card": "done · needs-you</span>[\\s\\S]*look at the change in use"},
               "c": {"column": "Done", "card": "done · waiting</span>[\\s\\S]*waits for: pi: `aplay"}}},
    {"do": "runner", "claims": "none"},
    {"do": "expect", "stage": {"a": "done"},
     "events": [{"item": "a", "kind": "done_verified", "actor": "loop (proof)", "data": {"verify": "^verified$"}, "count": 1}],
     "no_messages": [{"thread": "a", "text": "^(Verified|Proof)"}],
     "board": {"a": {"column": "Done", "card": "done · verified</span>[\\s\\S]*Proof passed: command", "page": "Verified\\?"}}},
    {"do": "clock", "advance": "24h"},
    {"do": "expect",
     "messages": [{"channel": "digest", "from": "orchestrator",
                   "text": "\\n\\*Done items\\* · 3 done: 1 verified, 1 needs-you, 1 waiting\\nYour checks \\(1\\):\\n• #2 Board colours — look at the change in use\\n"}]}
  ],
  "expect": {
    "stage": {"a": "done", "b": "done", "c": "done"},
    "events": [{"item": "a", "kind": "proof_set", "count": 1}, {"item": "b", "kind": "proof_set", "count": 1}, {"item": "c", "kind": "proof_set", "count": 1}],
    "no_events": [{"item": "a", "kind": "refused"}, {"item": "b", "kind": "done_proof_checked"}, {"item": "c", "kind": "done_proof_checked"}]
  }
}
