{
  "name": "held-then-approved",
  "about": "An auth-path PR passes review and CI; the land script holds it (no merge call) and the bot asks the approver. The approver replies \"approve\"; after the 2-minute Cancel window the item is back in land, the next land claim finds the approval for this head and merges. No agent ever runs for land.",
  "stages": ["build", "review", "land"],
  "steps": [
    {"do": "add", "item": "a", "title": "Shorten the session timeout"},
    {"do": "triage", "item": "a"},
    {"do": "script", "item": "a", "play": "good", "file": "internal/modules/auth/session.go"},
    {"do": "ci", "main": {"ci": "pass"}},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"},
    {"do": "ci", "item": "a", "checks": {"check": "pass"}},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"},
    {"do": "expect", "stage": {"a": "held"}, "pr": {"a": {"state": "OPEN", "merge_calls": 0}},
     "events": [{"item": "a", "kind": "advanced", "outcome": "hold", "actor": "runner",
                 "data": {"reason": "^on the hold list$", "changed_paths": "internal/modules/auth/session\\.go"}, "count": 1}],
     "messages": [{"thread": "a", "text": "<@U0C9AFPAMD4> #\\d+ Shorten the session timeout is held for your approval: .*sandbox/demo#101.* at `[0-9a-f]{7}`\\.\\nWhy: auth: A internal/modules/auth/session\\.go; land: on the hold list",
                   "buttons": ["Approve merge", "Keep holding"]}]},
    {"do": "runner", "claims": "none"},
    {"do": "reply", "item": "a", "as": "approver", "text": "approve"},
    {"do": "expect", "stage": {"a": "held"},
     "messages": [{"thread": "a", "from": "bot", "text": "^Approved by you: 'approve' for `[0-9a-f]{7}`\\. Merging in 2 minutes\\.", "buttons": ["Cancel"]}]},
    {"do": "runner", "claims": "none"},
    {"do": "clock", "advance": "2m"},
    {"do": "expect", "stage": {"a": "land"}, "events": [{"item": "a", "kind": "approved", "actor": "approver"}]},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"}
  ],
  "expect": {
    "stage": {"a": "done"},
    "agent_runs": {"build": 1, "review": 1, "land": 0},
    "pr": {"a": {"state": "MERGED", "merge_calls": 1}},
    "remote": {"main": "a", "only": true},
    "events": [
      {"item": "a", "kind": "claimed", "actor": "runner", "data": {"agent": "^sandbox-"}, "count": 4},
      {"item": "a", "kind": "advanced", "outcome": "merged", "actor": "runner", "count": 1},
      {"item": "a", "kind": "main_ci", "actor": "runner", "data": {"result": "^green$"}, "count": 1}
    ],
    "messages": [
      {"thread": "a", "text": "is held for your approval"},
      {"thread": "a", "from": "approver", "text": "^approve$"},
      {"thread": "a", "text": "^Approved by you for `[0-9a-f]{7}`: 'approve' → land\\.$"},
      {"thread": "a", "text": "^Claimed for land\\.$"},
      {"thread": "a", "text": "^Merged .*sandbox/demo#101> as `[0-9a-f]{7}`; watching main's CI\\.$"},
      {"thread": "a", "text": "^main green on `[0-9a-f]{7}`\\.$"}
    ]
  }
}
