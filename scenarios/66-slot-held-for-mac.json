{
  "name": "slot-held-for-mac",
  "about": "#192: with active_agents 2 and one slot taken, the last slot is held for the Mac runner (capabilities and only_resources [macos], seen just now) while its macos item can run: the dev box's runner claims nothing, the Mac takes the item, and once no macos item is left the next free slot goes to the dev box again. (The control's stop makes the Mac's first claim a check-in that takes nothing.)",
  "stages": ["build"],
  "steps": [
    {"do": "add", "item": "busy", "title": "Something already building", "priority": "P1"},
    {"do": "triage", "item": "busy"},
    {"do": "add", "item": "plain", "title": "Fix a typo in the README", "priority": "P1"},
    {"do": "triage", "item": "plain"},
    {"do": "add", "item": "mac", "title": "Mac server app progress window", "priority": "P4"},
    {"do": "triage", "item": "mac", "resources": "macos"},
    {"do": "control", "active_agents": 2},
    {"do": "hand_claim", "item": "busy"},

    {"do": "control", "stopped": true},
    {"do": "hand_claim", "via": "runner_listener", "capabilities": "macos", "only": "macos", "claims": "none"},
    {"do": "control", "stopped": false},

    {"do": "runner", "claims": "none"},
    {"do": "hand_claim", "via": "runner_listener", "item": "mac", "capabilities": "macos", "only": "macos"},
    {"do": "control", "active_agents": 3},
    {"do": "runner", "claims": "plain"}
  ],
  "expect": {
    "stage": {"mac": "build", "plain": "review", "busy": "build"},
    "events": [
      {"item": "mac", "kind": "claimed", "actor": "runner:hand", "count": 2},
      {"item": "plain", "kind": "claimed", "actor": "runner:sandbox", "count": 1}
    ],
    "agent_runs": {"build": 1}
  }
}
