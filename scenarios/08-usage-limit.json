{
  "name": "usage-limit",
  "about": "The agent hits the plan's session limit: the item goes back to its queue and claude claims pause until the reset the CLI reported (the active agents stay the user's 4); #loop-digest tells the approver with the reset time. While paused a P3 build of size S goes to qwen for that run (the sandbox runner has a qwen block), and the P2 waits; at the reset claims resume on their own and the P2 builds with claude (docs/decisions/2026-10-18-usage-awareness.md).",
  "qwen": true,
  "steps": [
    {
      "do": "add",
      "item": "a",
      "title": "Explain the hold list",
      "priority": "P2"
    },
    {
      "do": "add",
      "item": "b",
      "title": "Something else waiting"
    },
    {
      "do": "triage",
      "item": "a"
    },
    {
      "do": "triage",
      "item": "b"
    },
    {
      "do": "script",
      "item": "a",
      "play": "usage_limit"
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "runner_idle"
    },
    {
      "do": "expect",
      "messages": [
        {
          "channel": "digest",
          "pinned": true,
          "text": "^Active agents: 4 of 6$"
        },
        {
          "channel": "digest",
          "from": "bot",
          "pinned": false,
          "text": "^<@U0C9AFPAMD4> Usage limit hit on #\\d+ Explain the hold list: .+ \\(resets Thu 11:45\\)\\.\\nClaude claims paused until Thu 11:45; qwen builds and landing go on"
        }
      ]
    },
    {
      "do": "runner",
      "claims": "b"
    },
    {
      "do": "runner_idle"
    },
    {
      "do": "runner",
      "claims": "none"
    },
    {
      "do": "script",
      "item": "a",
      "play": "good"
    },
    {
      "do": "clock",
      "advance": "3h"
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "runner_idle"
    },
    {
      "do": "expect",
      "messages": [
        {
          "channel": "digest",
          "from": "bot",
          "text": "^Claude claims back to normal\\.$"
        }
      ]
    }
  ],
  "expect": {
    "stage": {
      "a": "review",
      "b": "review"
    },
    "control": {
      "active_agents": 4
    },
    "events": [
      {
        "item": "a",
        "kind": "usage_limit",
        "actor": "runner",
        "data": {
          "error": "rate limit|session limit",
          "reset": ".",
          "limit_window": "^5h$",
          "paused_until": "^2026-10-15T15:45:00Z$"
        }
      },
      {
        "kind": "usage_pace",
        "actor": "loopd",
        "data": {
          "until": "^2026-10-15T15:45:00Z$",
          "limit_window": "^5h$"
        }
      },
      {
        "item": "b",
        "kind": "claimed",
        "data": {
          "routed": "^qwen$"
        }
      },
      {
        "item": "b",
        "kind": "advanced",
        "data": {
          "builder": "^qwen$"
        }
      }
    ],
    "messages": [
      {
        "thread": "a",
        "text": "^Usage limit hit: .*\\(resets Thu 11:45\\)\\. Back in the queue; claude claims paused until Thu 11:45\\.$"
      },
      {
        "thread": "b",
        "text": "^Claimed for build, with qwen this run \\(paused until Thu 11:45 \\(the usage limit was hit\\)\\)\\.$"
      }
    ],
    "no_messages": [
      {
        "thread": "a",
        "text": "needs you"
      },
      {
        "channel": "digest",
        "text": "Active agents: 0 of 6"
      }
    ],
    "prs": 2
  }
}
