    },
    {
      "do": "plan_approve",
      "plan": "p",
      "doc": "brief"
    },
    {
      "do": "plan_turn",
      "plan": "p",
      "text": "Blueprint ready.",
      "ready": true,
      "blueprint": "# Blueprint\n\nApproach: one table.\n\n## Pieces\n\n### 1. Pantry table\n- repo: sandbox/demo\n- size: S\n- builder: qwen\n\nThe table and its migration.\n"
    },
    {
      "do": "plan_approve",
      "plan": "p",
      "doc": "blueprint",
      "text": "go"
    },
    {
