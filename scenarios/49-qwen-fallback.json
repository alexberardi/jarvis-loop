{
  "name": "qwen-fallback",
  "about": "The qwen builder's failures (docs/decisions/2026-10-19-qwen-routing.md): a qwen item's first build fails the runner's verify (the stand-in node-mobile's \"mobile shots\"): it goes back to build counting a bounce and one failed qwen build, and the next build resumes the qwen session with -s. That one fails verify too: the second bounce sends the item to the user as any item's, and loopd turns its builder to claude for the rest (event builder_fallback, reason failed_twice; the card shows builder: claude). After the user's answer, with verify passing, the build runs claude -p (no -s, no opencode), reports builder claude, and the item goes on. The thread says the needs-you once, then one line for the switch.",
  "qwen": true,
  "steps": [
    {
      "do": "plan",
      "plan": "p",
      "title": "Pantry list",
      "priority": "P2",
      "text": "a pantry list"
    },
    {
      "do": "plan_turn",
      "plan": "p",
      "text": "Brief ready.",
      "brief": "# Pantry list\n\nA list of what is in the pantry.",
      "ready": true
    },
    {
      "do": "plan_approve",
      "plan": "p",
      "doc": "brief"
    },
    {
      "do": "plan_turn",
      "plan": "p",
      "text": "Blueprint ready.",
      "ready": true,
      "blueprint": "# Blueprint\n\nApproach: one table.\n\n## Pieces\n\n### 1. Pantry table\n- repo: sandbox/jarvis-node-mobile\n- size: S\n- builder: qwen\n\nThe table and its migration.\n"
    },
    {
      "do": "plan_approve",
      "plan": "p",
      "doc": "blueprint",
      "text": "go"
    },
    {
      "do": "plan_items",
      "plan": "p",
      "pieces": [
        "a"
      ]
    },
    {
      "do": "triage",
      "item": "a"
    },
    {
      "do": "verify",
      "outcome": "fail"
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "runner_idle"
    },
    {
      "do": "expect",
      "stage": {
        "a": "build"
      },
      "events": [
        {
          "item": "a",
          "kind": "advanced",
          "outcome": "verify_failed",
          "actor": "runner",
          "data": {
            "builder": "^qwen$",
            "bounce_count": "^1$"
          },
          "count": 1
        }
      ],
      "no_events": [
        {
          "item": "a",
          "kind": "builder_fallback"
        }
      ]
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "runner_idle"
    },
    {
      "do": "expect",
      "stage": {
        "a": "needs_you"
      },
      "run_files": [
        {
          "item": "a",
          "stage": "build",
          "run": 2,
          "file": "argv.json",
          "text": "\"-s\",\"ses_fake_"
        }
      ],
      "events": [
        {
          "item": "a",
          "kind": "builder_fallback",
          "actor": "runner",
          "data": {
            "from": "^qwen$",
            "to": "^claude$",
            "reason": "^failed_twice$",
            "qwen_failures": "^2$",
            "outcome": "^verify_failed$"
          },
          "count": 1
        }
      ],
      "board": {
        "a": {
          "column": "Needs you",
          "card": "<span class=\"label\">builder: claude</span>"
        }
      }
    },
    {
      "do": "verify",
      "outcome": "pass"
    },
    {
      "do": "reply",
      "item": "a",
      "text": "go on with claude"
    },
    {
      "do": "script",
      "item": "a",
      "for": "review",
      "play": "approve"
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "runner_idle"
    },
    {
      "do": "expect",
      "stage": {
        "a": "review"
      },
      "run_files": [
        {
          "item": "a",
          "stage": "build",
          "run": 3,
          "file": "argv.json",
          "no_text": "^\\[\"run\",|\"-s\""
        }
      ],
      "events": [
        {
          "item": "a",
          "kind": "advanced",
          "outcome": "pr_opened",
          "actor": "runner",
          "data": {
            "builder": "^claude$"
          },
          "count": 1
        }
      ]
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "runner_idle"
    },
    {
      "do": "expect",
      "stage": {
        "a": "land"
      }
    }
  ],
  "expect": {
    "stage": {
      "a": "land"
    },
    "prs": 1,
    "events": [
      {
        "item": "a",
        "kind": "advanced",
        "outcome": "verify_failed",
        "actor": "runner",
        "data": {
          "builder": "^qwen$"
        },
        "count": 2
      },
      {
        "item": "a",
        "kind": "builder_fallback",
        "count": 1
      }
    ],
    "agent_runs": {
      "build": 3,
      "review": 1
    },
    "messages": [
      {
        "thread": "a",
        "text": "^<@U0C9AFPAMD4> #\\d+ Pantry table needs you: "
      },
      {
        "thread": "a",
        "text": "^Builder: qwen → claude for the rest of this item \\(qwen's build failed twice\\)\\.$"
      },
      {
        "thread": "a",
        "text": "^Answered by "
      }
    ]
  }
}
