{
  "name": "approval-not-carried-hold-path",
  "about": "An auth-path PR is approved while held; main then changes the same auth file. The build merges origin/main in and resolves the conflict inside its hunk only, but the conflict is in a file on the hold list: loopd drops the approval and land holds the new head for the approver. Nothing is merged.",
  "stages": [
    "build",
    "review",
    "land"
  ],
  "steps": [
    {
      "do": "add",
      "item": "a",
      "title": "Shorten the session timeout"
    },
    {
      "do": "triage",
      "item": "a"
    },
    {
      "do": "script",
      "item": "a",
      "play": "good",
      "file": "internal/modules/auth/session.go"
    },
    {
      "do": "ci",
      "main": {
        "ci": "pass"
      }
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "runner_idle"
    },
    {
      "do": "ci",
      "item": "a",
      "checks": {
        "check": "pass"
      }
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "runner_idle"
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "runner_idle"
    },
    {
      "do": "expect",
      "stage": {
        "a": "held"
      }
    },
    {
      "do": "press",
      "item": "a",
      "as": "approver",
      "button": "approve"
    },
    {
      "do": "expect",
      "stage": {
        "a": "land"
      },
      "events": [
        {
          "item": "a",
          "kind": "approved",
          "actor": "approver"
        }
      ]
    },
    {
      "do": "script",
      "item": "a",
      "for": "review",
      "play": "approve"
    },
    {
      "do": "script",
      "item": "a",
      "play": "merge_main",
      "file": "internal/modules/auth/session.go"
    },
    {
      "do": "push",
      "branch": "main",
      "file": "internal/modules/auth/session.go",
      "text": "main's own version of the change\n"
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "runner_idle"
    },
    {
      "do": "expect",
      "stage": {
        "a": "build"
      }
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "runner_idle"
    },
    {
      "do": "expect",
      "stage": {
        "a": "review"
      }
    },
    {
      "do": "ci",
      "item": "a",
      "checks": {
        "check": "pass"
      }
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "runner_idle"
    },
    {
      "do": "expect",
      "stage": {
        "a": "land"
      }
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "runner_idle"
    }
  ],
  "expect": {
    "stage": {
      "a": "held"
    },
    "pr": {
      "a": {
        "state": "OPEN",
        "merge_calls": 0
      }
    },
    "events": [
