      }
    ],
    "messages": [
      {
        "thread": "a",
        "text": "^The approval of `[0-9a-f]{7}` does not carry to `[0-9a-f]{7}`: a conflict was resolved in a file on the hold list \\(auth: M internal/modules/auth/session\\.go\\)\\. The new head needs your approval\\.$"
      }
    ]
  }
