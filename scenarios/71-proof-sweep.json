{
  "name": "proof-sweep",
  "about": "QA proofs (docs/decisions/2026-10-18-qa-proofs.md), the proof sweep: items in qa without a proof (built before proofs, or by a build that stated none) get one written by an orchestrate turn, once per item; on the first tick after this ships that is every item already in the QA column. a and b reach qa with no proof. At loopd's next tick a turn is queued with a proof_needed trigger for each; the orchestrator writes a's proof (a command) and b's (a manual check). The runner's next proof pass runs a's command and the loop verifies a; b stays for the user, on the board under needs you with what to look at. Later ticks and turns ask for no more proofs.",
  "stages": ["build", "review", "land", "orchestrate"],
  "steps": [
    {"do": "script", "for": "orchestrate", "play": "proofs"},
    {"do": "add", "item": "a", "title": "Old QA item one"},
    {"do": "add", "item": "b", "title": "Old QA item two"},
    {"do": "command", "as": "approver", "text": "qa 1"},
    {"do": "command", "as": "approver", "text": "qa 2"},
    {"do": "script", "item": "a", "for": "proof", "proof": [{"kind": "command", "run": "git merge-base --is-ancestor \"$LOOP_MERGE_SHA\" HEAD"}]},
    {"do": "triage", "item": "a"},
    {"do": "ci", "main": {"ci": "pass"}},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"},
    {"do": "ci", "item": "a", "checks": {"check": "pass"}},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"},
    {"do": "triage", "item": "b"},
    {"do": "runner", "claims": "b"},
    {"do": "runner_idle"},
    {"do": "ci", "item": "b", "checks": {"check": "pass"}},
    {"do": "runner", "claims": "b"},
    {"do": "runner_idle"},
    {"do": "runner", "claims": "b"},
    {"do": "runner_idle"},
    {"do": "expect", "stage": {"a": "qa", "b": "qa"},
     "board": {"a": {"column": "QA", "card": "needs you</span>[\\s\\S]*no proof: your check"}},
     "no_events": [{"item": "a", "kind": "proof_set"}]},
    {"do": "clock", "advance": "1m"},
    {"do": "runner", "claims": "orchestrator"},
    {"do": "runner_idle"},
    {"do": "expect", "stage": {"a": "qa", "b": "qa"},
     "events": [{"kind": "orchestrate_claimed", "count": 1},
                {"item": "a", "kind": "proof_set", "actor": "orchestrator", "data": {"by": "^sweep$", "reason": "^from the item, its PR and evidence$"}, "count": 1},
                {"item": "b", "kind": "proof_set", "actor": "orchestrator", "data": {"by": "^sweep$", "status": "^manual$"}, "count": 1}],
     "messages": [{"thread": "a", "from": "bot", "text": "^Orchestrator: wrote its proof \\(the proof sweep\\): command: `git merge-base --is-ancestor \"\\$LOOP_MERGE_SHA\" HEAD` \\(pending\\) — from the item, its PR and evidence\\.$"},
                  {"thread": "b", "from": "bot", "text": "^Orchestrator: wrote its proof \\(the proof sweep\\): look at the change in use \\(manual\\) — from the item, its PR and evidence\\.$"}]},
    {"do": "runner", "claims": "none"},
    {"do": "expect", "stage": {"a": "done", "b": "qa"},
     "events": [{"item": "a", "kind": "verified", "actor": "loop (proof)", "count": 1}],
     "board": {"b": {"column": "QA", "card": "needs you</span>[\\s\\S]*look at the change in use", "page": "Proof · by sweep"}}},
    {"do": "clock", "advance": "1h"},
    {"do": "runner"},
    {"do": "runner_idle"}
  ],
  "expect": {
    "stage": {"a": "done", "b": "qa"},
    "events": [{"item": "a", "kind": "proof_set", "count": 1}, {"item": "b", "kind": "proof_set", "count": 1}],
    "no_events": [{"item": "a", "kind": "refused"}, {"item": "b", "kind": "refused"}, {"item": "b", "kind": "proof_checked"}]
  }
}
