{
  "name": "land-past-six-builds",
  "about": "#213, as diagnosed on 2026-10-18: three items review approved wait in land, one of them needing macos (the Mac built and reviewed it), when six P1 builds whose agents hang take all six agent slots first (a P1 build goes before a P2 land item). The dev box's runner (no macos) claims all three for land next to the six builds, in three land lanes (land_slots and loopd's land limit default to 3), so all three wait on CI side by side; when CI passes they all squash-merge, and the builds keep their leases. With the agent slots and the land lanes full a seventh build waits; /loop stop ends the builds.",
  "stages": ["build", "land"],
  "slots": 6,
  "steps": [
    {"do": "ci", "main": {"ci": "pass"}},
    {"do": "control", "active_agents": 6},
    {"do": "add", "item": "a", "title": "Fix the digest wording", "priority": "P2"},
    {"do": "add", "item": "m", "title": "Mac server app progress window", "priority": "P2"},
    {"do": "add", "item": "c", "title": "Trim the digest footer", "priority": "P2"},
    {"do": "triage", "item": "a"},
    {"do": "triage", "item": "m"},
    {"do": "triage", "item": "c"},
    {"do": "script", "item": "a", "play": "good", "file": "digest.txt"},
    {"do": "script", "item": "m", "play": "good", "file": "mac/progress.txt"},
    {"do": "script", "item": "c", "play": "good", "file": "footer.txt"},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"},
    {"do": "runner", "claims": "m"},
    {"do": "runner_idle"},
    {"do": "runner", "claims": "c"},
    {"do": "runner_idle"},
    {"do": "ci", "item": "a", "checks": {"check": "pending"}},
    {"do": "ci", "item": "m", "checks": {"check": "pending"}},
    {"do": "ci", "item": "c", "checks": {"check": "pending"}},
    {"do": "review", "item": "a"},
    {"do": "review", "item": "m"},
    {"do": "review", "item": "c"},
    {"do": "resources", "item": "m", "resources": "macos"},
    {"do": "expect", "stage": {"a": "land", "m": "land", "c": "land"}, "leased": {"a": false, "m": false, "c": false}},
    {"do": "add", "item": "b1", "title": "Rework the board queries", "priority": "P1"},
    {"do": "add", "item": "b2", "title": "Split the store package", "priority": "P1"},
    {"do": "add", "item": "b3", "title": "Index the events table", "priority": "P1"},
    {"do": "add", "item": "b4", "title": "Page the runs list", "priority": "P1"},
    {"do": "add", "item": "b5", "title": "Cache the PR views", "priority": "P1"},
    {"do": "add", "item": "b6", "title": "Batch the Slack posts", "priority": "P1"},
    {"do": "add", "item": "b7", "title": "Waits for a slot", "priority": "P1"},
    {"do": "triage", "item": "b1"},
    {"do": "triage", "item": "b2"},
    {"do": "triage", "item": "b3"},
    {"do": "triage", "item": "b4"},
    {"do": "triage", "item": "b5"},
    {"do": "triage", "item": "b6"},
    {"do": "triage", "item": "b7"},
    {"do": "script", "item": "b1", "play": "hang"},
    {"do": "script", "item": "b2", "play": "hang"},
    {"do": "script", "item": "b3", "play": "hang"},
    {"do": "script", "item": "b4", "play": "hang"},
    {"do": "script", "item": "b5", "play": "hang"},
    {"do": "script", "item": "b6", "play": "hang"},
    {"do": "runner", "claims": "b1"},
    {"do": "agent_running", "item": "b1"},
    {"do": "runner", "claims": "b2"},
    {"do": "agent_running", "item": "b2"},
    {"do": "runner", "claims": "b3"},
    {"do": "agent_running", "item": "b3"},
    {"do": "runner", "claims": "b4"},
    {"do": "agent_running", "item": "b4"},
    {"do": "runner", "claims": "b5"},
    {"do": "agent_running", "item": "b5"},
    {"do": "runner", "claims": "b6"},
    {"do": "agent_running", "item": "b6"},
    {"do": "runner", "claims": "a"},
    {"do": "runner", "claims": "m"},
    {"do": "runner", "claims": "c"},
    {"do": "expect", "stage": {"a": "land", "m": "land", "c": "land", "b1": "build", "b6": "build", "b7": "build"},
      "leased": {"a": true, "m": true, "c": true, "b1": true, "b6": true, "b7": false},
      "pr": {"a": {"merge_calls": 0}, "m": {"merge_calls": 0}, "c": {"merge_calls": 0}}},
    {"do": "runner", "claims": "none"},
    {"do": "ci", "item": "a", "checks": {"check": "pass"}},
    {"do": "ci", "item": "m", "checks": {"check": "pass"}},
    {"do": "ci", "item": "c", "checks": {"check": "pass"}},
    {"do": "clock", "advance": "30s"},
    {"do": "wait", "stage": {"a": "done", "m": "done", "c": "done"}},
    {"do": "expect", "stage": {"b1": "build", "b6": "build"}, "leased": {"a": false, "m": false, "c": false, "b1": true, "b6": true, "b7": false}},
    {"do": "command", "as": "approver", "text": "stop", "answer": "^Stopped: running agents stop at their next heartbeat"},
    {"do": "clock", "advance": "60s"},
    {"do": "runner_idle"}
  ],
  "expect": {
    "control": {"active_agents": 6},
    "stage": {"a": "done", "m": "done", "c": "done", "b1": "build", "b2": "build", "b3": "build", "b4": "build", "b5": "build", "b6": "build", "b7": "build"},
    "leased": {"a": false, "m": false, "c": false, "b1": false, "b6": false, "b7": false},
    "agent_runs": {"build": 9, "review": 0, "land": 0},
    "pr": {
      "a": {"state": "MERGED", "merge_calls": 1},
      "m": {"state": "MERGED", "merge_calls": 1},
      "c": {"state": "MERGED", "merge_calls": 1}
    },
    "events": [
      {"item": "m", "kind": "resources", "data": {"to": "macos"}, "count": 1},
      {"item": "a", "kind": "advanced", "outcome": "merged", "actor": "runner", "count": 1},
      {"item": "m", "kind": "advanced", "outcome": "merged", "actor": "runner", "count": 1},
      {"item": "c", "kind": "advanced", "outcome": "merged", "actor": "runner", "count": 1}
    ],
    "no_events": [
      {"item": "m", "kind": "unservable"},
      {"item": "b7", "kind": "claimed", "actor": "runner"},
      {"item": "b1", "kind": "advanced", "actor": "runner"}
    ]
  }
}
