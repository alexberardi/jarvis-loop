{
  "name": "hang",
  "about": "The agent hangs. On the fake clock, 45 minutes pass in 30-second steps with heartbeats; the runner's time cap (45 minutes less its 30-second margin) stops the agent, saves its work as WIP on the item's branch and sends the item to the user.",
  "steps": [
    {
      "do": "add",
      "item": "a",
      "title": "Make the board faster"
    },
    {
      "do": "triage",
      "item": "a"
    },
    {
      "do": "script",
      "item": "a",
      "play": "hang"
    },
    {
      "do": "runner",
      "claims": "a"
    },
    {
      "do": "agent_running",
      "item": "a"
    },
    {
      "do": "clock",
      "advance": "44m"
    },
    {
      "do": "expect",
      "stage": {
        "a": "build"
      },
      "leased": {
        "a": true
      }
    },
    {
      "do": "clock",
      "advance": "30s"
    },
    {
      "do": "runner_idle"
    }
  ],
  "expect": {
    "stage": {
      "a": "needs_you"
    },
    "question": {
      "a": "the run hit the time cap \\(45 minutes\\); work so far is on loop/\\d+-make-the-board-faster\\. Last output: working on it"
    },
    "leased": {
      "a": false
    },
    "events": [
      {
        "item": "a",
        "kind": "advanced",
        "outcome": "failed",
        "actor": "runner"
      }
    ],
    "no_events": [
      {
        "item": "a",
        "kind": "run_overtime"
      },
      {
        "item": "a",
        "kind": "lease_expired"
      }
    ],
    "messages": [
      {
        "thread": "a",
        "text": "^Claimed for build\\.$"
      },
      {
        "thread": "a",
        "text": "^<@U0C9AFPAMD4> #\\d+ Make the board faster needs you: the run hit the time cap \\(45 minutes\\)"
      }
    ],
    "remote": {
      "branches": {
        "a": "^WIP: loop item #\\d+ \\(time cap\\)$"
      },
      "files": {
        "a": [
          "wip.txt"
        ]
      },
      "only": true
    },
    "prs": 0
  }
}
