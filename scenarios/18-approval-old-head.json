{
  "name": "approval-old-head",
  "about": "The approver approves a held auth-path PR; before land claims it again, someone pushes a new commit to the PR's branch. Land sees the head moved since review and sends it back to review: the approval is void, nothing is merged, main does not move.",
  "stages": ["build", "review", "land"],
  "steps": [
    {"do": "add", "item": "a", "title": "Shorten the session timeout"},
    {"do": "triage", "item": "a"},
    {"do": "script", "item": "a", "play": "good", "file": "internal/modules/auth/session.go"},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"},
    {"do": "ci", "item": "a", "checks": {"check": "pass"}},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"},
    {"do": "expect", "stage": {"a": "held"}},
    {"do": "press", "item": "a", "as": "approver", "button": "approve"},
    {"do": "expect", "stage": {"a": "land"}, "events": [{"item": "a", "kind": "approved", "actor": "approver"}]},
    {"do": "push", "item": "a", "file": "internal/modules/auth/extra.go", "text": "package auth // pushed after the approval\n"},
    {"do": "runner", "claims": "a"},
    {"do": "runner_idle"}
  ],
  "expect": {
    "stage": {"a": "review"},
    "agent_runs": {"land": 0},
    "pr": {"a": {"state": "OPEN", "merge_calls": 0}},
    "remote": {"branches": {"a": "^someone else's commit$"}, "only": true},
    "events": [
      {"item": "a", "kind": "advanced", "outcome": "back_to_review", "actor": "runner",
       "data": {"approval_voided": "^true$", "notes": "moved since review", "changed_paths": "internal/modules/auth/extra\\.go"}, "count": 1}
    ],
    "no_events": [
      {"item": "a", "kind": "advanced", "outcome": "merged"}
    ],
    "messages": [
      {"thread": "a", "text": "^#\\d+ Shorten the session timeout: approved by you for `[0-9a-f]{7}` \\(button\\)\\.$"},
      {"thread": "a", "text": "^Claimed for land\\.$"},
      {"thread": "a", "text": "^Back to review: The PR's head is `[0-9a-f]{7}`, but the review approved `[0-9a-f]{7}`"}
    ]
  }
}
