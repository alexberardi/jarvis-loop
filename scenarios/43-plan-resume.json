{
  "name": "plan-resume",
  "about": "Plans, scenario 7 (docs/phases/07-planning.md): the first product turn starts a session in the plan's own directory and loopd stores its id; the second passes --resume <that id> (the fake claude refuses a session it did not start in that directory) with only the new message, and the per-persona prefix holds: the new session's prompt opens with the product brief, the command lines differ only by --resume.",
  "stages": ["plan"],
  "steps": [
    {"do": "plan", "plan": "p", "title": "Pantry list", "priority": "P2", "text": "a pantry list"},
    {"do": "runner", "claims": "p"},
    {"do": "runner_idle"},
    {"do": "expect", "plans": {"p": {"turns": 1, "last_turn": "done", "docs": {"brief": 1}}}},
    {"do": "plan_say", "plan": "p", "text": "only the kitchen"},
    {"do": "runner", "claims": "p"},
    {"do": "runner_idle"}
  ],
  "expect": {
    "plans": {"p": {"stage": "brief", "turn": "you", "turns": 2, "last_turn": "done", "docs": {"brief": 2}}},
    "run_files": [{"plan": "p", "stage": "product", "run": 1, "file": "argv.json", "no_text": "--resume"},
                  {"plan": "p", "stage": "product", "run": 2, "file": "argv.json", "text": "\"--resume\",\"fake-session-P1-product\""},
                  {"plan": "p", "stage": "product", "run": 2, "file": "brief.md", "text": "^## This turn\\n[\\s\\S]*> only the kitchen\\n$", "no_text": "Product \\(planning\\)|a pantry list"}],
    "same_prefix": ["product"],
    "agent_runs": {"product": 2}
  }
}
