{
  "name": "orchestrator-acts-for-user",
  "about": "The @orchestrator app acts for the approver only on the approver's own messages to it (docs/phases/08-orchestrator.md, piece 2): a DM or a mention, recorded by its socket, never by the loop bot. Someone else's 'drop #1' is refused; the approver's drops it as the approver, via the orchestrator. Asked in the item's thread to approve, it cannot: the loop bot does not take the mention as a reply approval, and the orchestrator has the approval message posted again with its sha-bound button. It answers in the DM it was asked in.",
  "stages": ["build", "review", "land"],
  "steps": [
    {"do": "add", "item": "a", "title": "An old idea nobody needs"},
    {"do": "triage", "item": "a"},
    {"do": "add", "item": "b", "title": "Support Kasa plugs"},
    {"do": "triage", "item": "b"},
    {"do": "script", "item": "b", "play": "good", "file": "internal/modules/auth/kasa.go"},
    {"do": "ci", "main": {"ci": "pass"}},
    {"do": "expect", "stage": {"a": "build", "b": "build"}},

    {"do": "orchestrator", "item": "a", "action": "POST /items/{item}/drop", "as": "other", "text": "drop #1", "body": {"words": "drop #1"}, "refused": "HTTP 403.*\"code\":\"not_approver\""},
    {"do": "expect", "stage": {"a": "build"},
     "messages": [{"channel": "DORCHESTRATORU0SANDBOXOTHER", "from": "other", "text": "^drop #1$"}],
     "events": [{"kind": "orchestrator.message", "data": {"user": "^U0SANDBOXOTHER$", "approver": "^false$", "text": "^drop #1$"}, "count": 1}]},

    {"do": "orchestrator", "item": "a", "action": "POST /items/{item}/drop", "as": "approver", "text": "drop #1, it is stale", "body": {"words": "drop #1, it is stale"}},
    {"do": "expect", "stage": {"a": "closed"},
     "events": [{"item": "a", "kind": "dropped", "actor": "approver", "data": {"via": "^orchestrator:loop$"}, "count": 1}],
     "messages": [
       {"channel": "dm", "from": "approver", "text": "^drop #1, it is stale$", "reactions": ["eyes"]},
       {"thread": "a", "from": "bot", "text": "^Dropped by you via orchestrator: 'drop #1, it is stale'"}
     ]},
    {"do": "orchestrator", "action": "POST /orchestrator/replies", "body": {"channel": "{last_channel}", "thread_ts": "{last_ts}", "text": "Dropped #1."}},
    {"do": "expect", "messages": [{"channel": "dm", "from": "orchestrator", "text": "^Dropped #1\\.$"}]},

    {"do": "runner", "claims": "b"},
    {"do": "runner_idle"},
    {"do": "ci", "item": "b", "checks": {"check": "pass"}},
    {"do": "runner", "claims": "b"},
    {"do": "runner_idle"},
    {"do": "runner", "claims": "b"},
    {"do": "runner_idle"},
    {"do": "expect", "stage": {"b": "held"}},

    {"do": "tell_orchestrator", "as": "approver", "where": "thread", "item": "b", "text": "approve #2"},
    {"do": "orchestrator", "item": "b", "action": "POST /items/{item}/approve", "as": "approver", "message": "last", "body": {"head_sha": "{head}", "words": "approve #2"}, "refused": "HTTP 403.*\"code\":\"not_on_behalf\""},
    {"do": "orchestrator", "item": "b", "action": "POST /orchestrator/items/{item}/approval", "body": {"reason": "you asked me to approve #2"}},
    {"do": "expect", "stage": {"b": "held"},
     "messages": [{"thread": "b", "from": "bot", "text": "^Orchestrator: approvals are yours, so here is its approval message again — you asked me to approve #2", "buttons": ["Approve merge", "Keep holding", "Drop"]}],
     "events": [{"kind": "orchestrator.message", "data": {"approver": "^true$", "text": "^approve #2$", "item_id": "^2$"}, "count": 1}],
     "no_messages": [{"thread": "b", "from": "bot", "text": "Approving|Not taken as an approval"}],
     "no_events": [{"item": "b", "kind": "approved"}]},

    {"do": "press", "as": "approver", "item": "b", "button": "approve", "text": "Orchestrator: approvals are yours"},
    {"do": "expect", "events": [{"item": "b", "kind": "approved", "actor": "approver", "count": 1}],
     "no_events": [{"item": "b", "kind": "approved", "data": {"via": "."}}]}
  ],
  "expect": {
    "no_events": [{"item": "a", "kind": "dropped", "actor": "other"}]
  }
}
