<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta http-equiv="refresh" content="30">
<title>Jarvis Loop board</title>
{{template "style"}}
{{template "working-style"}}
<style>
.lanes { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; align-items: flex-start; }
.lane { flex: 0 0 min(85vw, 300px); scroll-snap-align: start; background: var(--lane); border: 1px solid var(--line); border-radius: 8px; padding: 8px; }
.lane h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin: 4px 4px 8px; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 8px 10px; margin-bottom: 8px; }
.card .title { font-weight: 600; text-decoration: none; color: var(--fg); display: block; }
.meta { color: var(--muted); font-size: 13px; display: flex; flex-wrap: wrap; gap: 4px 10px; }
.card .reason { font-size: 13px; margin-top: 4px; }
.label { font-size: 12px; border: 1px solid var(--line); border-radius: 4px; padding: 0 4px; }
.note { color: var(--muted); font-size: 13px; margin: 4px; }
.runners { background: var(--lane); border: 1px solid var(--line); border-radius: 8px; padding: 6px 12px; font-size: 14px; }
.frozen { background: #b91c1c; color: #fff; border-radius: 8px; padding: 8px 12px; margin-bottom: 12px; }
.frozen a, .frozen code { color: #fff; }
.orch { background: var(--lane); border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; margin-bottom: 16px; }
.orch summary { font-weight: 600; cursor: pointer; }
.orch h3 { font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin: 12px 0 4px; }
.orch ul { margin: 0; padding-left: 18px; font-size: 14px; }
.orch li { margin-bottom: 4px; }
.orch .why { color: var(--muted); }
.orch .notes > div { border-top: 1px solid var(--line); padding: 4px 0; font-size: 14px; }
</style>
</head>
<body>
<h1>Jarvis Loop</h1>
<p class="sub">{{.Total}} items ·{{if .PlanCount}} {{.PlanCount}} open plans ·{{end}} {{stamp .Now}} · refreshes every 30 s (working now: every 5 s) · {{if .ShowClosed}}<a href="/board">hide closed</a>{{else}}<a href="/board?closed=1">show closed</a>{{end}}</p>
{{- if .SecondOpinion.Runs}}
<p class="sub">Second opinion (Gemini): {{template "second-opinion" .SecondOpinion}}</p>
{{- end}}
{{- with .Runway}}
<p class="sub runway">{{if .Low}}<strong>Runway low:</strong>{{else}}Runway:{{end}} about {{printf "%.1f" .Hours}} agent-hours of work without you ({{.Runnable}} runnable){{with .Unblockers}} · frees the most:{{range $i, $u := .}}{{if $i}},{{end}} {{$u.Action}} <a href="/items/{{$u.ItemID}}">#{{$u.ItemID}}</a> → {{$u.Frees}}{{end}}{{end}}</p>
{{- end}}
{{- range .Draining}}
<p class="runners">Runner <strong>{{.Name}}</strong> is {{.State}} since {{stamp .Since}}: it claims nothing new and restarts once its runs end.</p>
{{- end}}
{{- range .Freezes}}
<div class="frozen" role="alert"><strong>Main is red in {{.Repo}}</strong>{{with .Jobs}} (failing: {{join . ", "}}){{end}}: frozen since {{stamp .Since}}. Nothing else in it moves stages until main is green; <a href="/items/{{.ItemID}}">#{{.ItemID}} {{.ItemTitle}}</a> goes first.{{if .Queued}} {{.Queued}} finished run(s) wait to apply.{{end}} Lift by hand: <code>loop unfreeze {{.Repo}}</code></div>
{{- end}}
{{- template "working-section" .Working}}
{{- with .Orch}}{{if .Show}}
<details class="orch"{{if .Escalations}} open{{end}}>
<summary>Orchestrator{{if not .Last.IsZero}} · last action {{stamp .Last}}{{end}}{{with len .Escalations}} · {{.}} open {{if eq . 1}}escalation{{else}}escalations{{end}}{{end}}</summary>
{{- if .Escalations}}
<h3>Open escalations</h3>
<ul>
{{- range .Escalations}}
<li>{{if .ItemID}}<a href="/board/items/{{.ItemID}}">#{{.ItemID}}</a> {{end}}<span class="reason">{{.Text}}</span>{{if .Recommendation}} · recommends: {{.Recommendation}}{{end}} <span class="why">({{stamp .At}})</span></li>
{{- end}}
</ul>
{{- end}}
{{- if .Actions}}
<h3>Recent actions</h3>
<ul>
{{- range .Actions}}
<li><span class="muted">{{stamp .At}}</span> {{if .ItemID}}<a href="/board/items/{{.ItemID}}">#{{.ItemID}}</a> {{.Title}}: {{end}}<span class="label">{{.Action}}</span>{{if .For}} for {{.For}}, via orchestrator{{end}}{{if eq .Actor "loopd"}} by loopd{{end}}{{if .Text}} {{.Text}}{{end}}{{if .Recommendation}} · recommends: {{.Recommendation}}{{end}}{{if .Reason}} <span class="why">· because {{.Reason}}</span>{{end}}</li>
{{- end}}
</ul>
{{- end}}
{{- if .Tickets}}
<h3>Its tickets</h3>
<ul>
{{- range .Tickets}}
<li><a href="/board/items/{{.ID}}">#{{.ID}} {{.Title}}</a> <span class="muted">{{.Priority}}</span> <span class="label">{{.Display}}</span></li>
{{- end}}
</ul>
{{- end}}
{{- if .Notes}}
<h3>Notebook</h3>
<div class="notes">
{{- range .Notes}}
<div><span class="muted">{{stamp .At}}</span>{{.Text}}</div>
{{- end}}
</div>
{{- end}}
</details>
{{- end}}{{end}}
{{- with .Runners}}{{if .Runners}}
<details class="orch"{{if .Holds}} open{{end}}>
<summary>Runners · {{len .Runners}} seen today{{with len .Holds}} · {{.}} {{if eq . 1}}slot{{else}}slots{{end}} held{{end}}</summary>
{{- if .Holds}}
<ul>
{{- range .Holds}}
<li>A slot is held for {{.Resource}} work: <a href="/board/items/{{.ItemID}}">#{{.ItemID}}</a> is waiting for {{.Runner}}.</li>
{{- end}}
</ul>
{{- end}}
<ul>
{{- range .Runners}}
<li>{{.Name}}{{if .Capabilities}} <span class="why">offers</span> {{range .Capabilities}}<span class="label">{{.}}</span> {{end}}{{end}}{{if .OnlyResources}}<span class="why">takes only</span> {{range .OnlyResources}}<span class="label">{{.}}</span> {{end}}{{end}}<span class="why">· seen {{age .Ago}} ago{{if not .Around}} (quiet){{end}}</span></li>
{{- end}}
</ul>
</details>
{{- end}}{{end}}
{{- with .Regressions}}{{if .Show}}
<details class="orch"{{if .Open}} open{{end}}>
<summary>Regressions{{with .Open}} · R{{.ID}} ({{.Suite}}) {{.Status}}{{end}}</summary>
{{- if .CanRun}}
{{- if .Open}}
<p class="note">One run at a time: R{{.Open.ID}} is {{.Open.Status}}.</p>
{{- else}}
<form method="post" action="/board/regressions">
<label>Suite <select name="suite">{{range .Suites}}<option value="{{.}}"{{if eq . "all"}} selected{{end}}>{{.}}</option>{{end}}</select></label>
<button type="submit">Run regression</button>
</form>
{{- end}}
{{- end}}
{{- if .Runs}}
<ul>
{{- range .Runs}}
<li><a href="/board/regressions/{{.ID}}">R{{.ID}}</a> {{.Suite}} <span class="label">{{.Status}}</span>{{if or (eq .Status "passed") (eq .Status "failed")}} {{.Passed}} passed, {{.Failed}} failed, {{.Skipped}} skipped{{end}}{{with .Error}} <span class="reason">{{.}}</span>{{end}} <span class="why">· {{age .Ago}} ago</span></li>
{{- end}}
</ul>
{{- end}}
</details>
{{- end}}{{end}}
<div class="lanes">
{{- range .Columns}}
<section class="lane">
<h2>{{.Name}} · {{.Count}}</h2>
{{- if .Note}}
<p class="note">{{.Note}}</p>
{{- end}}
{{- range .Plans}}
<article class="card">
<a class="title" href="/board/plans/{{.ID}}">P{{.ID}} {{.Title}}</a>
<div class="meta">
{{- range .RepoNames}}<span>{{.}}</span>{{end}}
<span>{{.Priority}}</span>
<span class="label">{{.Stage}}</span>
{{- with turnLabel .Turn}}<span>{{.}}</span>{{end}}
<span>active {{age .Idle}} ago</span>
</div>
</article>
{{- end}}
{{- range .Cards}}
<article class="card">
<a class="title" href="/board/items/{{.ID}}">#{{.ID}} {{.Title}}</a>
<div class="meta">
{{- if .RepoName}}<span>{{.RepoName}}</span>{{end}}
<span>{{.Priority}}</span>
<span>{{age .AgeSeconds}}</span>
{{- if .Label}}<span class="label">{{.Label}}</span>{{end}}
{{- if .ClaimedBy}}<span>{{.ClaimedBy}}</span>{{end}}
{{- if .PRURL}}<a href="{{.PRURL}}">PR #{{.PR}}</a>{{end}}
{{- if .SlackURL}}<a href="{{.SlackURL}}">thread</a>{{end}}
{{- if .PlanID}}<a class="label" href="/board/plans/{{.PlanID}}">plan P{{.PlanID}}</a>{{end}}
{{- if .Builder}}<span class="label">builder: {{.Builder}}</span>{{end}}
{{- if and .Unservable (not .ClaimedBy)}}<span class="label">{{unservable .Unservable}}</span>{{end}}
{{- range .Waits}}<span class="label">waiting on {{.}}</span>{{end}}
{{- with .SecondOpinion}}<span class="label" title="Gemini's findings; Claude agreed with {{.Agreed}} of {{.Judged}} judged">Gemini {{.Findings}} · {{.Agreed}} agreed</span>{{end}}
</div>
{{- if .Reason}}
<div class="reason">{{.Reason}}</div>
{{- end}}
{{- range .ReopenedDeps}}
<div class="reason">Depends on #{{.Dependency}}, which was reopened: {{.Words}} (the fix is #{{.ReopenItem}})</div>
{{- end}}
</article>
{{- end}}
</section>
{{- end}}
</div>
</body>
</html>
