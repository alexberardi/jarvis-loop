{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "'/opt/loop/loop-guard'",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'/opt/loop/loop-guard'",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr comment *)",
      "Bash(scripts/check)",
      "Bash(scripts/check *)",
      "Bash(scripts/sandbox *)",
      "Bash(scripts/fetch-sherpa-libs.sh *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Edit(./**)"
    ],
    "defaultMode": "dontAsk",
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh ruleset *)",
      "Bash(gh workflow *)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(gh api *-X PUT*)",
      "Bash(gh api *-XPUT*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *--method=PUT*)",
      "Bash(gh api *-X PATCH*)",
      "Bash(gh api *-XPATCH*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *--method=PATCH*)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(adb)",
      "Bash(adb *)",
      "Bash(sudo *)",
      "Bash(pkexec *)",
      "Bash(doas *)",
      "Bash(systemctl *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(kill)",
      "Bash(kill -)",
      "Bash(kill - *)",
      "Bash(kill --*)",
      "Bash(kill -1*)",
      "Bash(kill -2*)",
      "Bash(kill -3*)",
      "Bash(kill -4*)",
      "Bash(kill -5*)",
      "Bash(kill -6*)",
      "Bash(kill -7*)",
      "Bash(kill -8*)",
      "Bash(kill -9*)",
      "Bash(kill -00*)",
      "Bash(kill 0*)",
      "Bash(kill -01*)",
      "Bash(kill 1*)",
      "Bash(kill -02*)",
      "Bash(kill 2*)",
      "Bash(kill -03*)",
      "Bash(kill 3*)",
      "Bash(kill -04*)",
      "Bash(kill 4*)",
      "Bash(kill -05*)",
      "Bash(kill 5*)",
      "Bash(kill -06*)",
      "Bash(kill 6*)",
      "Bash(kill -07*)",
      "Bash(kill 7*)",
      "Bash(kill -08*)",
      "Bash(kill 8*)",
      "Bash(kill -09*)",
      "Bash(kill 9*)",
      "Bash(kill -A*)",
      "Bash(kill -a*)",
      "Bash(kill -B*)",
      "Bash(kill -b*)",
      "Bash(kill -C*)",
      "Bash(kill -c*)",
      "Bash(kill -D*)",
      "Bash(kill -d*)",
      "Bash(kill -E*)",
      "Bash(kill -e*)",
      "Bash(kill -F*)",
      "Bash(kill -f*)",
      "Bash(kill -G*)",
      "Bash(kill -g*)",
      "Bash(kill -H*)",
      "Bash(kill -h*)",
      "Bash(kill -I*)",
      "Bash(kill -i*)",
      "Bash(kill -J*)",
      "Bash(kill -j*)",
      "Bash(kill -K*)",
      "Bash(kill -k*)",
      "Bash(kill -L*)",
      "Bash(kill -l*)",
      "Bash(kill -M*)",
      "Bash(kill -m*)",
      "Bash(kill -N*)",
      "Bash(kill -n*)",
      "Bash(kill -O*)",
      "Bash(kill -o*)",
      "Bash(kill -P*)",
      "Bash(kill -p*)",
      "Bash(kill -Q*)",
      "Bash(kill -q*)",
      "Bash(kill -R*)",
      "Bash(kill -r*)",
      "Bash(kill -S*)",
      "Bash(kill -s*)",
      "Bash(kill -T*)",
      "Bash(kill -t*)",
      "Bash(kill -U*)",
      "Bash(kill -u*)",
      "Bash(kill -V*)",
      "Bash(kill -v*)",
      "Bash(kill -W*)",
      "Bash(kill -w*)",
      "Bash(kill -X*)",
      "Bash(kill -x*)",
      "Bash(kill -Y*)",
      "Bash(kill -y*)",
      "Bash(kill -Z*)",
      "Bash(kill -z*)",
      "Bash(kill %*)",
      "Bash(kill $*)",
      "Bash(kill `*)",
      "Bash(kill \"*)",
      "Bash(kill '*)",
      "Bash(kill \\*)",
      "Bash(kill {*)",
      "Bash(kill (*)",
      "Bash(kill ~*)",
      "Bash(kill ?*)",
      "Bash(kill [*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -fr ..*)",
      "Bash(curl *127.0.0.1:7780*)",
      "Bash(wget *127.0.0.1:7780*)",
      "Bash(curl *localhost:7780*)",
      "Bash(wget *localhost:7780*)",
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "Read(//home/u/.config/jarvis-harness)",
      "Read(//home/u/.config/jarvis-harness/**)",
      "Read(//home/u/.ssh)",
      "Read(//home/u/.ssh/**)",
      "Read(//home/u/.config/jarvis-loop/runner.json)",
      "Read(//home/u/.config/jarvis-loop/runner.json/**)",
      "Edit(//home/u/.config/jarvis-harness)",
      "Edit(//home/u/.config/jarvis-harness/**)",
      "Edit(//home/u/.ssh)",
      "Edit(//home/u/.ssh/**)",
      "Edit(//home/u/jarvis/jarvis-server)",
      "Edit(//home/u/jarvis/jarvis-server/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "allowWrite": [
        "/home/u/.cache/go-build",
        "/home/u/go/pkg/mod",
        "/home/u/.npm",
        "/home/u/.cache/jarvis-harness"
      ],
      "denyRead": [
        "/home/u/.config/jarvis-harness",
        "/home/u/.ssh",
        "/home/u/.config/jarvis-loop/runner.json"
      ],
      "denyWrite": [
        "/home/u/.config/jarvis-harness",
        "/home/u/.ssh",
        "/home/u/jarvis/jarvis-server"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "proxy.golang.org",
        "sum.golang.org",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ],
      "deniedDomains": [
        "127.0.0.1:7780",
        "localhost:7780"
      ],
      "strictAllowlist": true
    }
  }
}
